# NEON: usa la URL JDBC, no la URL postgresql:// sin prefijo.
SPRING_DATASOURCE_URL=jdbc:postgresql://TU_HOST.neon.tech/TU_BD?sslmode=require
SPRING_DATASOURCE_USERNAME=TU_USUARIO
SPRING_DATASOURCE_PASSWORD=TU_PASSWORD

# MONGODB ATLAS
SPRING_DATA_MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/Parfum?retryWrites=true&w=majority

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# FRONTENDS PERMITIDOS POR CORS (producción + Netlify actual)
CORS_ORIGINS=https://parfum.com.pe,https://www.parfum.com.pe,https://parfum-store-app.netlify.app

# SESIONES: 7 días por defecto
APP_TOKEN_DAYS=7

# ADMIN INICIAL / EXISTENTE
APP_ADMIN_EMAIL=admin@parfum.pe
APP_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_LARGA_Y_UNICA
APP_ADMIN_NAME=Administrador Parfum

# IMPORTANTE: los productos/precios/stock/imágenes se administran en Neon desde el panel Admin.
# Mantener false evita que un deploy vuelva a importar perfumes.json y pise cambios reales.
APP_CATALOG_SYNC=false

# Variable histórica: mantener desactivada.
APP_SEED_DATA=false
