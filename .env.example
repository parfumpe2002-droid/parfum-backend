# NEON: usa la URL JDBC, no la URL postgresql:// sin prefijo.
SPRING_DATASOURCE_URL=jdbc:postgresql://TU_HOST.neon.tech/TU_BD?sslmode=require
SPRING_DATASOURCE_USERNAME=TU_USUARIO
SPRING_DATASOURCE_PASSWORD=TU_PASSWORD

# MONGODB ATLAS
SPRING_DATA_MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/Parfum?retryWrites=true&w=majority

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# FRONTEND PERMITIDO POR CORS
CORS_ORIGINS=https://parfum-store-app.netlify.app,https://*.netlify.app,http://localhost:8383,http://localhost:5500

# CREA EL PRIMER ADMIN AL INICIAR (cámbialo luego)
APP_ADMIN_EMAIL=admin@parfum.pe
APP_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE
APP_ADMIN_NAME=Administrador Parfum

# Con true, inserta los 43 perfumes faltantes por SKU sin duplicarlos.
APP_SEED_DATA=false
